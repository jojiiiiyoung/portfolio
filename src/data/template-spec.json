{
  "template": "Brittany Chiang v4 Inspired - Two Column",
  "layout": {
    "desktop": {
      "type": "two-column",
      "sidebar": { "width": "45%", "position": "sticky", "top": 0 },
      "content": { "width": "55%", "scrollable": true }
    },
    "mobile": {
      "type": "single-column",
      "sidebarBehavior": "collapses to header"
    },
    "maxWidth": "1280px",
    "padding": "96px 48px"
  },
  "sections": ["about", "experience", "projects", "contact"],
  "colors": {
    "darkNavy": "#0a192f",
    "navy": "#112240",
    "lightNavy": "#233554",
    "lightestNavy": "#303C55",
    "slate": "#8892b0",
    "lightSlate": "#a8b2d1",
    "lightestSlate": "#ccd6f6",
    "white": "#e6f1ff",
    "green": "#64ffda",
    "greenTint": "rgba(100, 255, 218, 0.1)"
  },
  "typography": {
    "fontSans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "fontMono": "'JetBrains Mono', 'SF Mono', 'Fira Code', monospace",
    "heroName": { "size": "clamp(40px, 8vw, 72px)", "weight": 700, "letterSpacing": "-0.03em" },
    "sectionTitle": { "size": "clamp(26px, 5vw, 32px)", "weight": 700, "letterSpacing": "-0.02em" },
    "body": { "size": "16px", "weight": 400, "lineHeight": 1.7 },
    "mono": { "size": "13px", "weight": 400 }
  },
  "animations": {
    "fadeUp": { "distance": "20px", "duration": "0.5s", "easing": "cubic-bezier(0.645, 0.045, 0.355, 1)" },
    "staggerDelay": "100ms",
    "hoverTransition": "0.25s cubic-bezier(0.645, 0.045, 0.355, 1)",
    "scrollSpy": true
  },
  "patterns": {
    "numberedSections": true,
    "sectionNumberFormat": "01.",
    "horizontalRule": "extends from section title",
    "tabExperience": "company tabs left, details right",
    "projectCards": "image with green overlay on hover",
    "socialSidebar": "fixed vertical on left edge (desktop only)"
  }
}
